// icon.rc — ресурсы приложения Dine 1.0.0 (by rosey)
#include <windows.h>

IDI_ICON1 ICON "@DINE_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "rosey\0"
            VALUE "FileDescription", "Dine 1.0.0 - by rosey\0"
            VALUE "FileVersion", "1.0.0\0"
            VALUE "InternalName", "Dine\0"
            VALUE "OriginalFilename", "Dine-1.0.0.exe\0"
            VALUE "ProductName", "Dine\0"
            VALUE "ProductVersion", "1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
